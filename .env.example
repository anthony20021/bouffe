# Configuration locale actuelle (serveur WebSocket Node).
VITE_WS_URL=ws://localhost:3000

# Configuration prévue pour Supabase + Vercel.
# Supabase Dashboard > Settings > API > Project URL / Publishable key
VITE_SUPABASE_URL=https://votre-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle_publique

# Serveur / Edge Function uniquement : ne jamais exposer cette clé dans Vite.
# À créer dans Supabase Dashboard > Settings > API > Secret keys.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_secrete_serveur
